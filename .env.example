# 数据库类型（目前仅支持 mysql）
DB_TYPE=mysql

# 数据库连接信息
DB_HOST=localhost
DB_PORT=3306
DB_USER=your_user
DB_PASSWORD=your_password
DB_NAME=auto_news

# 备用数据库（可选：主库连不上时自动切换写入，不配置则只写主库）
# DB2_HOST=backup_host
# DB2_PORT=3306
# DB2_USER=backup_user
# DB2_PASSWORD=backup_password
# DB2_NAME=backup_db

# 爬取模式
# local = 仅写入本地 JSON 文件（默认）
# online = 写入 MySQL 数据库
CRAWLER_MODE=local

# 站点 Cookie（可选，用于通过懂车帝登录墙 / 易车验证码风控）
# 获取方式：浏览器登录后 F12 -> Network -> 任选该站请求 -> 复制请求头中完整的 Cookie 值
# DONGCHEDI_COOKIE=ttwid=xxx; sessionid=xxx; ...
# YICHE_COOKIE=xxx

